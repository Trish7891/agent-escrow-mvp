{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-escrow.dev/schema/evidence.schema.json",
  "title": "AgentEscrow evidence bundle",
  "description": "What the seller submits. Only the bundle's keccak256 goes on-chain; the bundle is content-addressed and immutable once delivered.",
  "type": "object",
  "required": [
    "schema_version",
    "job_ref",
    "terms_hash",
    "delivered_utc",
    "artifacts",
    "claims",
    "seller_signer"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "terms_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "Must equal the job's terms_hash. Mismatch = evidence for a different contract."
    },
    "delivered_utc": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "uri", "sha256", "media_type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "uri": { "type": "string", "minLength": 4 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_id", "result", "evidence_kind"],
        "additionalProperties": false,
        "properties": {
          "test_id": { "type": "string" },
          "result": { "enum": ["pass", "fail", "not_applicable"] },
          "evidence_kind": {
            "enum": ["computed", "attested", "judged"],
            "description": "How the claim was produced: a program, a signed attestation, or a human."
          },
          "method": { "type": "string", "description": "Command, script, or attestor identity." },
          "detail": { "type": "string" },
          "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payment proof. Optional at delivery, required before release on any chain-settled job.",
      "required": ["chain_id", "tx_hash", "payer", "payee", "amount_units", "nonce"],
      "properties": {
        "chain_id": { "type": "integer" },
        "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "payer": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "payee": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "amount_units": { "type": "string", "pattern": "^[0-9]+$" },
        "nonce": {
          "type": "string",
          "minLength": 8,
          "description": "Unique per job (job_ref + attempt). Duplicate nonce = double-spend attempt, hard fail."
        },
        "confirmations": { "type": "integer", "minimum": 0 }
      }
    },
    "seller_signer": {
      "type": "object",
      "required": ["address", "signature", "signed_payload_sha256"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "signature": { "type": "string", "minLength": 10 },
        "signed_payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
