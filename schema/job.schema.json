{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-escrow.dev/schema/job.schema.json",
  "title": "AgentEscrow job spec",
  "description": "Agreed before funding. terms_hash binds this exact document to the on-chain job; evidence is judged against it and it cannot be edited afterwards.",
  "type": "object",
  "required": [
    "schema_version",
    "job_ref",
    "title",
    "buyer",
    "seller",
    "amount",
    "deadline_utc",
    "review_window_seconds",
    "silence_outcome",
    "acceptance_tests",
    "evidence_required"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Stable human-readable id, also used as the settlement nonce seed."
    },
    "title": { "type": "string", "minLength": 8, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 4000 },
    "buyer": { "$ref": "#/$defs/party" },
    "seller": { "$ref": "#/$defs/party" },
    "amount": { "$ref": "#/$defs/money" },
    "deadline_utc": { "type": "string", "format": "date-time" },
    "review_window_seconds": {
      "type": "integer",
      "minimum": 3600,
      "description": "Buyer's window to accept or dispute after delivery. Minimum 1h."
    },
    "silence_outcome": {
      "enum": ["release", "refund"],
      "description": "Pre-agreed direction if the buyer never responds inside the review window. Chosen in public before money moves."
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    },
    "evidence_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "media_type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 3 },
          "max_bytes": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "dispute": {
      "type": "object",
      "required": ["arbiter"],
      "additionalProperties": false,
      "properties": {
        "arbiter": {
          "type": "string",
          "minLength": 3,
          "description": "Named adjudicator. A job without a named arbiter is not escrow, it is a promise."
        },
        "stake": { "$ref": "#/$defs/money" },
        "window_seconds": { "type": "integer", "minimum": 3600 },
        "appeals": { "type": "boolean", "default": false }
      }
    },
    "terms_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "keccak256 of the canonical JSON of this document with the terms_hash key removed."
    },
    "created_utc": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "agent", "org"] },
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "contact": { "type": "string" }
      }
    },
    "money": {
      "type": "object",
      "required": ["currency", "units"],
      "additionalProperties": false,
      "properties": {
        "currency": { "enum": ["ETH", "USDC", "USDT", "USD"] },
        "units": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Integer base units, e.g. 2000000 USDC = $2.00 at 6 decimals."
        },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 18 },
        "display": { "type": "string", "description": "Human string only; never the source of truth." }
      }
    },
    "test": {
      "type": "object",
      "required": ["id", "kind", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "kind": {
          "enum": ["deterministic", "attestation", "judgement"],
          "description": "deterministic = a program decides; attestation = a named third party signs; judgement = a human decides."
        },
        "description": { "type": "string", "minLength": 8 },
        "mandatory": { "type": "boolean", "default": true },
        "check": {
          "type": "object",
          "description": "Machine-readable check for deterministic tests: {type, path, operator, value}.",
          "additionalProperties": true
        },
        "attestor": {
          "type": "string",
          "description": "Required when kind=attestation: who is allowed to sign this claim."
        }
      }
    }
  }
}
